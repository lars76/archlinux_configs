{
  "permissions": {
    "allow": [
      "WebFetch"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "__HOME__/.claude/statusline.sh",
    "refreshInterval": 60
  }
}
