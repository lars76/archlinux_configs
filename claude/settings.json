{
  "model": "opus[1m]",
  "fallbackModel": [
    "opus",
    "sonnet[1m]"
  ],
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,

  "permissions": {
    "allow": [
      "WebFetch",
      "Bash(touch ~/.cache/claude-no-draft-check-*)",
      "Bash(rm -f ~/.cache/claude-no-draft-check-*)"
    ],
    "defaultMode": "auto"
  },

  "tui": "fullscreen",
  "theme": "custom:catppuccin-mocha",
  "editorMode": "normal",
  "statusLine": {
    "type": "command",
    "command": "__HOME__/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/draft-check.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import json,pathlib,sys; s=str(json.load(sys.stdin).get(\"session_id\") or \"\"); s and (pathlib.Path.home()/\".cache\"/(\"claude-no-draft-check-\"+s)).unlink(missing_ok=True)'"
          }
        ]
      }
    ]
  },
  "spinnerTipsEnabled": false,
  "preferredNotifChannel": "kitty",
  "autoMemoryEnabled": false,

  "attribution": {
    "commit": "",
    "pr": ""
  },

  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },

  "cleanupPeriodDays": 365,
  "autoUpdatesChannel": "latest",

  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
